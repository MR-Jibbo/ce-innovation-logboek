{
  "name": "ce-innovation-logboek",
  "version": "2.3.0",
  "productName": "CE-Innovation Logboek",
  "description": "Log skills and learning outcomes",
  "author": "Jibbe Beeftink",
  "private": true,
  "type": "module",
  "main": "build/main/index.js",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:main": "tsc -p main/tsconfig.json",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p main/tsconfig.json",
    "start": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac --publish=never",
    "dist:win": "npm run build && electron-builder --win --publish=never",
    "dist": "npm run build && electron-builder --mac --win --publish=never"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.87.4",
    "@tanstack/react-router": "^1.131.36",
    "docx": "^9.5.1",
    "htmlparser2": "^12.0.0",
    "image-size": "^2.0.2",
    "lucide-react": "^0.542.0",
    "mammoth": "^1.12.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.5.3",
    "vite": "^8.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "app.jibbe.ce-innovation-logboek",
    "productName": "CE-Innovation Logboek",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "main-window.html",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "app-icon.icns",
      "identity": "-",
      "gatekeeperAssess": false,
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
